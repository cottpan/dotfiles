#!/usr/bin/env zsh
#
# fnewtree - 新規ブランチ + worktree を fzf から作る
#
# Description:
#   ベースブランチを fzf で選び、新しいブランチ名を入力して worktree を作る。
#   「何を作るか」を決めるだけで、作成そのものは wtadd に委譲する。
#   作成後の処理（設定ファイルのコピー / セットアップ / cd）は
#   ~/.zsh/worktree-hooks/ のフックが担当する。
#
# Usage:
#   fnewtree
#
# Non-interactive equivalent:
#   wtadd feat/new-feature --base origin/develop
#
fnewtree() {
  if ! git rev-parse --git-dir &> /dev/null; then
    echo "❌ Not in a git repository"
    return 1
  fi

  local base_line base_ref new_branch wt_path

  echo "🌿 Select base branch to create new branch from:"
  base_line=$(__wt_pick_branch "base branch > " "Select a base branch for the new branch") || return 0

  if [ -z "$base_line" ]; then
    echo "❌ No base branch selected"
    return 1
  fi
  base_ref=$(__wt_strip_marker "$base_line")

  echo ""
  echo "🏷️  Enter new branch name:"
  read new_branch

  if [ -z "$new_branch" ]; then
    echo "❌ Branch name cannot be empty"
    return 1
  fi

  if git show-ref --verify --quiet "refs/heads/$new_branch"; then
    echo "❌ Branch '$new_branch' already exists"
    return 1
  fi

  echo ""
  wt_path=$(__wt_prompt_path "$(__wt_default_path "$new_branch")")

  wtadd --branch "$new_branch" --base "$base_ref" --path "$wt_path" --source new
  local rc=$?

  __wt_clear_screen
  return $rc
}
