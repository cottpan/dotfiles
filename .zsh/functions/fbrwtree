#!/usr/bin/env zsh
#
# fbrwtree - 既存ブランチから worktree を fzf で作る
#
# Description:
#   ローカル / リモートのブランチを fzf で選んで worktree を作る。
#   リモートブランチを選んだ場合、同名のローカルブランチが無ければ新しく作る。
#   作成そのものは wtadd に委譲し、作成後の処理は worktree-hooks が担当する。
#
# Usage:
#   fbrwtree
#
# Non-interactive equivalent:
#   wtadd feat/existing                       # ローカルブランチをそのまま使う
#   wtadd feat/existing --base origin/feat/existing   # リモートから作る
#
fbrwtree() {
  if ! git rev-parse --git-dir &> /dev/null; then
    echo "❌ Not in a git repository"
    return 1
  fi

  local branch_line branch_ref branch_name wt_path

  branch_line=$(__wt_pick_branch "branches > " "Select a branch to create worktree") || return 0

  if [ -z "$branch_line" ]; then
    __wt_clear_screen
    return 0
  fi

  branch_ref=$(__wt_strip_marker "$branch_line")
  branch_name=$(__wt_local_name "$branch_ref")

  wt_path=$(__wt_prompt_path "$(__wt_default_path "$branch_name")")

  local -a args
  args=( --branch "$branch_name" --path "$wt_path" --source branch )
  # リモートブランチを選んだときだけ起点を渡す。
  # ローカルブランチが既にある場合は wtadd 側で --base を無視してそれを使う。
  [[ "$branch_ref" == remotes/* ]] && args+=( --base "$branch_ref" )

  wtadd "${args[@]}"
  local rc=$?

  __wt_clear_screen
  return $rc
}
