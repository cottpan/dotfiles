#!/usr/bin/env zsh
#
# fprwtree - Pull Request から worktree を fzf で作る
#
# Description:
#   GitHub の open PR を fzf で選んで worktree を作る。
#   fork からの PR ならリモートを追加して fetch してから作成する。
#   作成そのものは wtadd に委譲し、作成後の処理は worktree-hooks が担当する。
#   既定のパス: <親>/<リポジトリ名>.worktree/pr-<番号>-<ブランチ名>
#
# Requirements:
#   - GitHub CLI (gh)
#
# Usage:
#   fprwtree
#
# Non-interactive equivalent（fetch 済みなら）:
#   wtadd feat/pr-branch --base origin/feat/pr-branch --name pr-123-feat/pr-branch --pr 123
#
fprwtree() {
  if ! command -v gh &> /dev/null; then
    echo "❌ GitHub CLI (gh) is not installed. Please install it first."
    echo "   brew install gh"
    return 1
  fi

  if ! git rev-parse --git-dir &> /dev/null; then
    echo "❌ Not in a git repository"
    return 1
  fi

  local prs selected_pr pr_number branch_name wt_path

  echo "🔍 Fetching pull requests..."
  prs=$(gh pr list --state open --limit 50 --json number,title,author,headRefName --template '{{range .}}#{{.number}} | {{.title}} | @{{.author.login}} | {{.headRefName}}{{"\n"}}{{end}}')

  if [ -z "$prs" ]; then
    echo "📭 No open pull requests found"
    return 0
  fi

  selected_pr=$(echo "$prs" | fzf \
    --prompt="PRs > " \
    --header="Select a Pull Request to create worktree" \
    --preview="echo {} | cut -d'|' -f1 | sed 's/^#//' | xargs -I {} gh pr view {} --json title,author,body,headRefName,url --template 'Title: {{.title}}
Author: @{{.author.login}}
Branch: {{.headRefName}}
URL: {{.url}}

Description:
{{.body}}'" \
    --preview-window="right:60%" \
    --reverse \
    --border \
    --ansi \
    --delimiter="|" \
    --with-nth="1,2,3") || return 0

  if [ -z "$selected_pr" ]; then
    __wt_clear_screen
    return 0
  fi

  pr_number=$(echo "$selected_pr" | cut -d'|' -f1 | sed 's/^#//' | tr -d ' ')
  branch_name=$(echo "$selected_pr" | cut -d'|' -f4 | tr -d ' ')

  wt_path=$(__wt_prompt_path "$(__wt_default_path "pr-${pr_number}-${branch_name}")")

  # PR の head を取ってくる（fork の場合はリモートを足す）
  echo "📥 Fetching PR branch..."
  local pr_details
  pr_details=$(gh pr view "$pr_number" --json isCrossRepository,headRepository,headRefName,headRepositoryOwner --template '{{.isCrossRepository}}:{{.headRepositoryOwner.login}}/{{.headRepository.name}}:{{.headRefName}}')

  if [ -z "$pr_details" ]; then
    echo "❌ Failed to get PR details"
    return 1
  fi

  local is_cross_repo=$(echo "$pr_details" | cut -d':' -f1)
  local head_repo=$(echo "$pr_details" | cut -d':' -f2)
  local head_branch=$(echo "$pr_details" | cut -d':' -f3)
  local base_ref

  if [[ "$is_cross_repo" == "true" ]]; then
    local remote_name="pr-${pr_number}-remote"
    local remote_url="https://github.com/${head_repo}.git"

    if ! git remote get-url "$remote_name" &> /dev/null; then
      echo "🔗 Adding remote: $remote_name"
      git remote add "$remote_name" "$remote_url"
    fi

    echo "📦 Fetching from fork..."
    git fetch "$remote_name" "$head_branch" || return 1
    base_ref="${remote_name}/${head_branch}"
  else
    echo "📦 Fetching branch..."
    git fetch origin "$head_branch" || return 1
    base_ref="origin/${head_branch}"
  fi

  wtadd --branch "$head_branch" --base "$base_ref" --path "$wt_path" --pr "$pr_number"
  local rc=$?

  if [ $rc -eq 0 ] || [ $rc -eq 3 ]; then
    echo "🔗 PR #${pr_number}: $(echo "$selected_pr" | cut -d'|' -f2 | sed 's/^ *//')"
  fi

  __wt_clear_screen
  return $rc
}
